# Optional overrides for the Belladonna RAG benchmark.
# The benchmark does NOT call OpenRouter — it only talks to your local RAG
# server. The RAG server itself reads VIRTUAL_API_KEY / BASE_URL from the
# belladonna_rag/.env; this benchmark does not need any API key.

# Where the local Belladonna RAG /query endpoint is served (start.sh -> :8001).
# You can also pass --rag-url on the command line instead.
BELLADONNA_RAG_URL=http://127.0.0.1:8001/query
